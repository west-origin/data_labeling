{
  "additionalProperties": false,
  "description": "학습 실행 하나 (데이터셋 버전 하나에서 모델 하나를 학습).\n\n- run_id: 실행 ID.\n- dataset_version_id: 학습 데이터를 뽑은 데이터셋 버전 (DB FK → dataset_versions).\n- model_name, model_version: 학습기 이름과 결과 모델 버전 문자열.\n- mlflow_run_id: MLflow 실행 ID. MLflow에 기록하지 않았으면 None.\n- created_at: 실행 시각.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_version_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Dataset Version Id",
      "type": "string"
    },
    "mlflow_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mlflow Run Id"
    },
    "model_name": {
      "title": "Model Name",
      "type": "string"
    },
    "model_version": {
      "title": "Model Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "dataset_version_id",
    "model_name",
    "model_version",
    "created_at"
  ],
  "title": "TrainingRun",
  "type": "object"
}
