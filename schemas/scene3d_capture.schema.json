{
  "$defs": {
    "PhotoEntry": {
      "additionalProperties": false,
      "description": "수집한 사진 한 장. photo_id는 원본 바이트 sha256에서 만든다 (같은 사진은 같은 ID).\n\nwidth/height는 EXIF 방향(orientation)을 적용한 뒤의 크기다. orientation은 원본 EXIF 값(1~8,\n없으면 1). 원본 위치·파일 이름은 담지 않는다 (라벨링 쪽 기록에도 쓰이므로).",
      "properties": {
        "ext": {
          "enum": [
            ".jpg",
            ".jpeg",
            ".png"
          ],
          "title": "Ext",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "orientation": {
          "maximum": 8,
          "minimum": 1,
          "title": "Orientation",
          "type": "integer"
        },
        "photo_id": {
          "pattern": "^p[0-9a-f]{16}$",
          "title": "Photo Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "photo_id",
        "sha256",
        "ext",
        "width",
        "height",
        "orientation"
      ],
      "title": "PhotoEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "한 세션의 한 단계(청소 전 또는 후) 사진 묶음. 사진은 photo_id 순으로 정렬한다.",
  "properties": {
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "phase": {
      "enum": [
        "before",
        "after"
      ],
      "title": "Phase",
      "type": "string"
    },
    "photos": {
      "items": {
        "$ref": "#/$defs/PhotoEntry"
      },
      "minItems": 1,
      "title": "Photos",
      "type": "array"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "phase",
    "photos",
    "ingested_at"
  ],
  "title": "PhotoCapture",
  "type": "object"
}
