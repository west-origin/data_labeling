{
  "$defs": {
    "ReviewMode": {
      "description": "검수 방식. 블라인드·이중의 결과는 측정용 레코드, 오류 삽입 과제의 결과는 학습에서 빠진다.",
      "enum": [
        "standard",
        "blind",
        "seeded_error",
        "double",
        "qa"
      ],
      "title": "ReviewMode",
      "type": "string"
    },
    "ReviewStage": {
      "description": "프라이버시 검수는 원본 접근 권한자만, 작업 라벨 검수는 블러본만 본다.",
      "enum": [
        "privacy",
        "labeling",
        "qa"
      ],
      "title": "ReviewStage",
      "type": "string"
    },
    "ReviewTaskStatus": {
      "enum": [
        "open",
        "collected"
      ],
      "title": "ReviewTaskStatus",
      "type": "string"
    },
    "ReviewTool": {
      "enum": [
        "cvat",
        "label_studio"
      ],
      "title": "ReviewTool",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assignee": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assignee"
    },
    "assignment_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assignment Id"
    },
    "collected_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Collected At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "external_id": {
      "title": "External Id",
      "type": "string"
    },
    "label_kinds": {
      "items": {
        "type": "string"
      },
      "title": "Label Kinds",
      "type": "array"
    },
    "media_uri": {
      "title": "Media Uri",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/ReviewMode",
      "default": "standard"
    },
    "sent_label_ids": {
      "anyOf": [
        {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "작업에 보낸 라벨. 수집은 이 라벨과 비교한다 (그 사이 라벨이 바뀌어도)",
      "title": "Sent Label Ids"
    },
    "session_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/ReviewStage"
    },
    "status": {
      "$ref": "#/$defs/ReviewTaskStatus",
      "default": "open"
    },
    "stream_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Stream Id",
      "type": "string"
    },
    "task_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Task Key",
      "type": "string"
    },
    "tool": {
      "$ref": "#/$defs/ReviewTool"
    }
  },
  "required": [
    "task_key",
    "tool",
    "external_id",
    "session_id",
    "stream_id",
    "stage",
    "media_uri",
    "label_kinds",
    "created_at"
  ],
  "title": "ReviewTask",
  "type": "object"
}
