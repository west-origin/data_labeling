{
  "$defs": {
    "ModelStatus": {
      "enum": [
        "candidate",
        "passed",
        "deployed",
        "rejected",
        "retired"
      ],
      "title": "ModelStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "재학습한 모델 버전 (레지스트리). 학습 실행 하나가 모델 버전 하나를 만든다.",
  "properties": {
    "artifact_uri": {
      "description": "가중치·설정 파일 위치 (학습 산출물 버킷)",
      "title": "Artifact Uri",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decided_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "게이트 판정 또는 은퇴 시각",
      "title": "Decided At"
    },
    "model_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Model Version",
      "type": "string"
    },
    "report_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "골든셋 평가·게이트 리포트",
      "title": "Report Uri"
    },
    "run_id": {
      "description": "학습 실행 (training_runs)",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ModelStatus"
    },
    "task": {
      "description": "평가 과제 (objects, hands, body, contact, actions, privacy 등)",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Task",
      "type": "string"
    },
    "train_examples": {
      "description": "학습에 쓴 예제 수 (누적 판단에 쓴다)",
      "minimum": 0,
      "title": "Train Examples",
      "type": "integer"
    },
    "trainer": {
      "description": "학습기 이름. 배포할 때 같은 이름의 로더로 읽는다",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Trainer",
      "type": "string"
    }
  },
  "required": [
    "model_version",
    "task",
    "run_id",
    "trainer",
    "artifact_uri",
    "sha256",
    "train_examples",
    "status",
    "created_at"
  ],
  "title": "ModelVersion",
  "type": "object"
}
