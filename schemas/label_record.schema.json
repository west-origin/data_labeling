        "action_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "contact_held": {
          "default": false,
          "description": "연속 접촉 묶음의 중간·끝 행동 (접촉 시작이 앞 행동에 있음)",
          "title": "Contact Held",
          "type": "boolean"
        },
        "direction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "hand": {
          "$ref": "#/$defs/Hand"
        },
        "kind": {
          "const": "action",
          "default": "action",
          "title": "Kind",
          "type": "string"
        },
        "post_state": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            }
          },
          "title": "Post State",
          "type": "object"
        },
        "pre_state": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            }
          },
          "title": "Pre State",
          "type": "object"
        },
        "t_approach_ms": {
          "description": "마스터 타임라인 기준 시각(ms)",
          "minimum": 0,
          "title": "T Approach Ms",
          "type": "integer"
        },
        "t_contact_end_ms": {
          "anyOf": [
            {
              "description": "마스터 타임라인 기준 시각(ms)",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T Contact End Ms"
        },
        "t_contact_start_ms": {
          "anyOf": [
            {
              "description": "마스터 타임라인 기준 시각(ms)",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T Contact Start Ms"
        },
        "t_end_ms": {
          "description": "마스터 타임라인 기준 시각(ms)",
          "minimum": 0,
          "title": "T End Ms",
          "type": "integer"
        },
        "target_body_part": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Body Part"
        },
        "target_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "tool_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Id"
        },
        "verb": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
