        },
        "qy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qy"
        },
        "qz": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qz"
        },
        "t_ms": {
          "description": "마스터 타임라인 기준 시각(ms)",
