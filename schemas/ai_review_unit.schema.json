        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                1,
                2,
                3
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        }
      },
      "required": [
        "event_type"
      ],
      "title": "EventPayload",
      "type": "object"
    },
    "GapPayload": {
