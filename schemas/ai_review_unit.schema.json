          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Gap Type",
          "type": "string"
        },
        "hand": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hand"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "gap",
          "default": "gap",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "gap_type"
      ],
      "title": "GapPayload",
      "type": "object"
    },
    "Hand": {
