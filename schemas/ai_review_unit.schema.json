      "properties": {
        "body_part": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body Part"
        },
        "contact_target_kind": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Contact Target Kind",
          "type": "string"
        },
        "grasp_type": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grasp Type"
        },
        "hand": {
          "$ref": "#/$defs/Hand"
