    "PhysicalPriors": {
      "additionalProperties": false,
      "description": "객체 클래스의 물리 사전값 (재질·촉감·질량·정지 마찰 계수). 측정값이 아니라 사전값(prior)이다.\n\n클래스의 흔한 실물 범위를 넓게 잡은 값이며, 영상 속 특정 물체를 잰 값이 아니다. 내보내기는\n`measured: false`와 출처(source)를 함께 싣는다 (ADR 0049).",
      "properties": {
        "mass_kg": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatePriorRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "질량 사전값 범위 (kg)"
        },
        "material": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "part_materials": {
          "description": "도구 부분 ID → 재질 ID (대표 재질과 다른 부분만)",
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            }
          },
          "title": "Part Materials",
          "type": "object"
        },
        "source": {
          "$ref": "#/$defs/PriorSource",
          "description": "수치 사전값의 출처 (prior_*: 측정값이 아님)"
        },
        "static_friction": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatePriorRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "정지 마찰 계수 사전값 범위 (무차원). 상대면: 건조한 맨손 피부·니트릴 장갑·고무 그리퍼 패드. 물체 쪽 면: 도구는 파지부(grip_parts), 그 밖은 주 접촉면. 젖음은 by_state.wetness"
        },
        "tactile": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "title": "Tactile",
          "type": "array"
        }
      },
      "required": [
        "source"
      ],
      "title": "PhysicalPriors",
      "type": "object"
    },
    "PriorRange": {
      "additionalProperties": false,
      "description": "사전값 범위 [min, max]. 둘 다 0보다 큰 유한한 수이고 min ≤ max다. 측정값이 아니다.",
      "properties": {
        "max": {
          "exclusiveMinimum": 0,
          "title": "Max",
          "type": "number"
        },
        "min": {
          "exclusiveMinimum": 0,
          "title": "Min",
          "type": "number"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "title": "PriorRange",
      "type": "object"
    },
