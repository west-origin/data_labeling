        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "ko": {
          "title": "Ko",
          "type": "string"
        },
        "phase": {
          "title": "Phase",
          "type": "string"
        }
      },
      "required": [
        "ko",
        "phase"
      ],
      "title": "DomainTerm",
      "type": "object"
