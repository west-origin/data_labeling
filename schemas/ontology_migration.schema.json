{
  "additionalProperties": false,
  "description": "온톨로지 버전 간 매핑 표 (config/ontology/migrations/<from>__<to>.yaml 한 파일).\n\n- from_version, to_version: 이관 전과 후의 온톨로지 버전.\n- renames: 범주 → {옛 ID: 새 ID}. 목록에 없는 ID는 그대로 둔다.\n- removed: 범주 → 새 버전에서 없어진 ID. 이런 값을 가진 라벨은 이관하지 않고 needs_review로\n  보낸다.\n\n범주는 `Category` 값만 쓸 수 있다 (대부분 `Ontology`의 같은 이름 사전, substeps와 parts는 예외).",
  "properties": {
    "from_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "From Version",
      "type": "string"
    },
    "removed": {
      "additionalProperties": {
        "items": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": "string"
        },
        "type": "array"
      },
      "default": {},
      "description": "새 버전에 대응 ID가 없어 사람이 다시 라벨링할 ID",
      "propertyNames": {
        "enum": [
          "verbs",
          "tasks",
          "substeps",
          "objects",
          "privacy_targets",
          "events",
          "gap_types",
          "grasp_types",
          "body_parts",
          "contact_target_kinds",
          "hand_roles",
          "parts"
        ]
      },
      "title": "Removed",
      "type": "object"
    },
    "renames": {
      "additionalProperties": {
        "patternProperties": {
          "^[a-z][a-z0-9_]{0,63}$": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          }
        },
        "type": "object"
      },
      "default": {},
      "propertyNames": {
        "enum": [
          "verbs",
          "tasks",
          "substeps",
          "objects",
          "privacy_targets",
          "events",
          "gap_types",
          "grasp_types",
          "body_parts",
          "contact_target_kinds",
          "hand_roles",
          "parts"
        ]
      },
      "title": "Renames",
      "type": "object"
    },
    "to_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "To Version",
      "type": "string"
    }
  },
  "required": [
    "from_version",
    "to_version"
  ],
  "title": "OntologyMigration",
  "type": "object"
}
