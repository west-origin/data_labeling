    },
    "duration_ms": {
      "description": "마스터 타임라인 기준 시각(ms)",
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "export_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Export Id",
      "type": "string"
    },
    "exported_at": {
      "format": "date-time",
      "title": "Exported At",
      "type": "string"
    },
    "format": {
      "const": "dlp-intervals",
      "default": "dlp-intervals",
      "title": "Format",
      "type": "string"
    },
    "format_version": {
      "default": "1.2",
      "title": "Format Version",
      "type": "string"
    },
    "labels": {
      "items": {
        "$ref": "#/$defs/ExportedLabel"
      },
      "title": "Labels",
      "type": "array"
    },
    "ontology_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Ontology Version",
      "type": "string"
    },
    "physical_priors": {
      "anyOf": [
        {
          "$ref": "#/$defs/PhysicalPriorTable"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "객체 물리 사전값 표 (측정값 아님, 형식 1.2, ADR 0049)"
    },
    "session_id": {
      "description": "가명 (내보내기마다 다른 HMAC)",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "site_id": {
      "description": "가명 (내보내기마다 다른 HMAC)",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Site Id",
      "type": "string"
    },
    "split": {
      "$ref": "#/$defs/Split"
    },
    "streams": {
      "items": {
        "$ref": "#/$defs/ExportedStream"
      },
      "title": "Streams",
      "type": "array"
    },
    "term_names": {
      "additionalProperties": {
        "$ref": "#/$defs/TermName"
      },
      "description": "온톨로지 항목 \"<범주>:<ID>\" → 한·영 표시 이름 (ko, en)",
      "title": "Term Names",
      "type": "object"
    },
    "worker_id": {
      "description": "가명 (내보내기마다 다른 HMAC)",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Worker Id",
      "type": "string"
    }
  },
  "required": [
    "export_id",
    "dataset_version_id",
    "ontology_version",
    "session_id",
    "split",
    "domain",
    "worker_id",
    "site_id",
    "duration_ms",
    "streams",
    "labels",
    "exported_at"
  ],
  "title": "IntervalFile",
  "type": "object"
}
