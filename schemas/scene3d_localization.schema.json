        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Blurred Sha256"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "frame_count": {
      "minimum": 0,
      "title": "Frame Count",
      "type": "integer"
    },
    "intrinsics": {
      "$ref": "#/$defs/CameraIntrinsics"
    },
    "intrinsics_origin": {
      "title": "Intrinsics Origin",
      "type": "string"
    },
    "localized": {
      "minimum": 0,
      "title": "Localized",
      "type": "integer"
    },
    "metric": {
      "title": "Metric",
      "type": "boolean"
    },
    "model_version": {
      "title": "Model Version",
      "type": "string"
    },
    "poses": {
      "items": {
        "$ref": "#/$defs/FramePose"
      },
      "title": "Poses",
      "type": "array"
    },
    "render_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Render Hash",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "stream_id": {
      "title": "Stream Id",
      "type": "string"
    }
  },
