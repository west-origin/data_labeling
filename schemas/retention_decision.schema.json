{
  "additionalProperties": false,
  "description": "원본 보관 기간이 다가오거나 지난 세션에 대한 결정 (연장은 기한과 사유가 필요하다).",
  "properties": {
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decided_by": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Decided By",
      "type": "string"
    },
    "decision": {
      "enum": [
        "extend",
        "delete"
      ],
      "title": "Decision",
      "type": "string"
    },
    "decision_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Decision Id",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "until": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Until"
    }
  },
  "required": [
    "decision_id",
    "session_id",
    "decision",
    "reason",
    "decided_by",
    "decided_at"
  ],
  "title": "RetentionDecision",
  "type": "object"
}
