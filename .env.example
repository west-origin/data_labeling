# 개발용 기본값. `make up`이 .env가 없으면 이 파일을 복사한다. 운영 환경에서는 반드시 바꾼다.
#
# 이 파일의 값은 두 곳에서 쓰인다.
#   1) docker compose (services/docker-compose.yml, `make up`의 --env-file .env) — 서비스 계정·포트.
#   2) `dlp` CLI·테스트 — 셸에 .env를 불러온 경우(`set -a; . ./.env; set +a`). 불러오지 않으면 코드의
#      기본값(대부분 이 파일과 같은 개발값)을 쓴다.
# 값(등호 오른쪽)을 바꾸면 compose 볼륨에 이미 만들어진 계정·버킷과 어긋날 수 있다: `make clean` 후 `make up`.
#
# 이 파일에 없지만 코드가 읽는 선택 변수 (필요하면 .env에 추가한다):
#   DLP_HOST                 `dlp services check`가 점검할 호스트 (기본 localhost)
#   DLP_ACTOR                감사·운영 기록의 실행자 이름 (기본 OS 사용자). 파이프라인 계정은 svc-pipeline
#                            (config/policies/ops.yaml audit.service_accounts)
#   DLP_S3_ENDPOINT          S3 엔드포인트 (기본 http://localhost:8333)
#   DLP_S3_PUBLIC_ENDPOINT   라벨러 브라우저가 닿는 S3 주소 (서명 URL용, 기본 DLP_S3_ENDPOINT)
#   DLP_MLFLOW_URL           MLflow 주소 (기본 http://localhost:${DLP_MLFLOW_PORT})
#   DLP_VLM_URL              OpenAI 호환 VLM 서버 (`dlp actions run`, 없으면 행동 구간을 만들지 않는다)
#   DLP_CVAT_PORT 외 CVAT 접속 정보는 아래 CVAT 절 참고

# docker compose 프로젝트 이름 (컨테이너·볼륨 이름 접두). 바꾸면 기존 볼륨을 못 찾는다.
COMPOSE_PROJECT_NAME=dlp

# PostgreSQL 관리 계정 (dlp 메타데이터 DB와 labelstudio·prefect·mlflow DB를 모두 이 계정으로 만든다,
# services/postgres/init-databases.sh). 최초 기동 때만 적용된다 (볼륨이 있으면 바꿔도 무시).
DLP_POSTGRES_USER=dlp
DLP_POSTGRES_PASSWORD=dlp-dev-password
# 호스트에 여는 PostgreSQL 포트 (`dlp services check`도 이 변수를 본다)
DLP_POSTGRES_PORT=5432
# dlp 메타데이터 DB (dlp db upgrade, 통합 테스트). 모든 `dlp` 명령의 `--url` 기본값이다.
# 위 계정·포트를 바꾸면 이 URL도 함께 바꾼다 (드라이버: psycopg 3).
DLP_DATABASE_URL=postgresql+psycopg://dlp:dlp-dev-password@localhost:5432/dlp

# SeaweedFS S3 (원본·라벨링·데이터셋·MLflow 버킷)
# 서비스(파이프라인) 자격 증명: 모든 버킷 읽기·쓰기. 원본 버킷(dlp-raw)에 닿으므로 운영에서는
# 서비스 계정과 원본 권한자에게만 나눠 준다 (ADR 0021: 저장소 접근 제어가 1차 통제).
DLP_S3_ACCESS_KEY=dlp-dev-access
DLP_S3_SECRET_KEY=dlp-dev-secret
# 호스트에 여는 S3 포트
DLP_S3_PORT=8333
# 일반 라벨러용 자격 증명: 라벨링 버킷(블러본) 읽기 전용
# (검수 화면 서명 URL을 이 키로 만든다, services/seaweedfs/entrypoint.sh가 권한을 건다)
DLP_S3_LABELER_ACCESS_KEY=dlp-dev-labeler
DLP_S3_LABELER_SECRET_KEY=dlp-dev-labeler-secret

# Label Studio (시간 구간 검수). 호스트 포트 (컨테이너 안은 8080)
DLP_LABEL_STUDIO_PORT=8081
# 관리자 계정 (최초 기동 때 만든다). 가입은 링크 없이는 막혀 있다.
DLP_LABEL_STUDIO_USER=admin@dlp.local
DLP_LABEL_STUDIO_PASSWORD=dlp-dev-password
# API 토큰 (40자 이하). 최초 기동 때 관리자 계정에 부여된다.
# `dlp review …`의 Label Studio 클라이언트와 services/label-studio/bootstrap.py가 쓴다.
DLP_LABEL_STUDIO_TOKEN=dlpdevlabelstudiotoken0000000000000000

# Prefect 서버 (작업 흐름 실행) 호스트 포트. UI의 API 주소도 이 포트로 만든다.
DLP_PREFECT_PORT=4200

# lakeFS (데이터셋 버전)
# 호스트 포트 (`dlp dataset build`, `dlp train run`, `dlp export`가 localhost:<포트>로 접속)
DLP_LAKEFS_PORT=8000
# 최초 설치 관리자 키 (lakeFS 형식: 접근 키는 AKIA로 시작하는 20자, 비밀 키 40자). CLI도 이 키로 접속한다.
DLP_LAKEFS_ACCESS_KEY=AKIAJDLPDEVACCESSKEY
DLP_LAKEFS_SECRET_KEY=dlpdevlakefssecretkey0000000000000000000
# lakeFS 내부 자격 증명 암호화 키. 볼륨을 만든 뒤 바꾸면 lakeFS가 기존 메타데이터를 못 읽는다.
DLP_LAKEFS_ENCRYPT_SECRET=dlp-dev-lakefs-encrypt-secret
# MLflow 추적 서버 호스트 포트 (산출물은 S3 dlp-mlflow 버킷, 메타데이터는 PostgreSQL mlflow DB)
DLP_MLFLOW_PORT=5000

# CVAT는 공식 compose로 따로 띄운다 (make cvat-up)
# 받아 올 CVAT 공식 저장소 태그 (services/cvat/cvat.sh가 이 버전을 내려받는다). 바꾸면 API 호환을 확인한다.
DLP_CVAT_VERSION=v2.78.0
# 호스트에 여는 CVAT 포트 (services/cvat/ports.override.yml, `dlp review`의 CVAT 클라이언트)
DLP_CVAT_PORT=8080
# 검수 도구 웹훅 서명 비밀 (dlp review serve / register-webhooks)
DLP_WEBHOOK_SECRET=dlp-dev-webhook-secret
# CVAT 관리자 계정 (`make cvat-superuser`로 만들고, `dlp review`가 이 계정으로 작업을 만든다)
DLP_CVAT_ADMIN_USER=admin
DLP_CVAT_ADMIN_PASSWORD=dlp-dev-password
DLP_CVAT_ADMIN_EMAIL=admin@dlp.local
# 실행 환경. dev가 아니면 아래 개발용 내보내기 비밀값을 거부한다 (export.yaml ids.env_var·dev_envs)
DLP_ENV=dev
# 내보내기 작업자·장소·세션·라벨 ID 가명화 비밀 (export.yaml ids.secret_env). 비우면 실행마다 임의 키.
# 운영에서는 반드시 바꾼다 (이 값은 DLP_ENV=dev에서만 받아들인다)
DLP_EXPORT_ID_SECRET=dlp-dev-export-id-secret
