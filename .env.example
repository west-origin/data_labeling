# 개발용 기본값. `make up`이 .env가 없으면 이 파일을 복사한다. 운영 환경에서는 반드시 바꾼다.
COMPOSE_PROJECT_NAME=dlp

DLP_POSTGRES_USER=dlp
DLP_POSTGRES_PASSWORD=dlp-dev-password
DLP_POSTGRES_PORT=5432
# dlp 메타데이터 DB (dlp db upgrade, 통합 테스트)
DLP_DATABASE_URL=postgresql+psycopg://dlp:dlp-dev-password@localhost:5432/dlp

# SeaweedFS S3 (원본·라벨링·데이터셋·MLflow 버킷)
DLP_S3_ACCESS_KEY=dlp-dev-access
DLP_S3_SECRET_KEY=dlp-dev-secret
DLP_S3_PORT=8333
# 일반 라벨러용 자격 증명: 라벨링 버킷(블러본) 읽기 전용
DLP_S3_LABELER_ACCESS_KEY=dlp-dev-labeler
DLP_S3_LABELER_SECRET_KEY=dlp-dev-labeler-secret

DLP_LABEL_STUDIO_PORT=8081
DLP_LABEL_STUDIO_USER=admin@dlp.local
DLP_LABEL_STUDIO_PASSWORD=dlp-dev-password
# API 토큰 (40자 이하). 최초 기동 때 관리자 계정에 부여된다.
DLP_LABEL_STUDIO_TOKEN=dlpdevlabelstudiotoken0000000000000000

DLP_PREFECT_PORT=4200

# lakeFS (데이터셋 버전)
DLP_LAKEFS_PORT=8000
DLP_LAKEFS_ACCESS_KEY=AKIAJDLPDEVACCESSKEY
DLP_LAKEFS_SECRET_KEY=dlpdevlakefssecretkey0000000000000000000
DLP_LAKEFS_ENCRYPT_SECRET=dlp-dev-lakefs-encrypt-secret
DLP_MLFLOW_PORT=5000

# CVAT는 공식 compose로 따로 띄운다 (make cvat-up)
DLP_CVAT_VERSION=v2.78.0
DLP_CVAT_PORT=8080
# 검수 도구 웹훅 서명 비밀 (dlp review serve / register-webhooks)
DLP_WEBHOOK_SECRET=dlp-dev-webhook-secret
DLP_CVAT_ADMIN_USER=admin
DLP_CVAT_ADMIN_PASSWORD=dlp-dev-password
DLP_CVAT_ADMIN_EMAIL=admin@dlp.local
