# DGX Spark VLM 서버 설정 (services/vlm/docker-compose.yml). `cp vlm.env.example vlm.env` 뒤 채운다.
# vlm.env는 저장소에 넣지 않는다 (.gitignore). 안내: docs/handover/vlm-server.md

# NGC vLLM 컨테이너 (Arm64·GB10 지원 태그). 장비 도착 시 NGC 카탈로그(nvcr.io/nvidia/vllm)에서 확인해
# 고정 태그로 적는다 (latest 금지). `dlp aireview probe`가 엔진 버전을 보고서에 남긴다.
VLM_IMAGE=

# 서버 API 키 (파이프라인 호스트의 DLP_VLM_API_KEY와 같은 값). 출력·기록하지 않는다
DLP_VLM_API_KEY=

# AI 1차 검수 판정 모델 (config/policies/aireview.yaml backend.model과 같아야 한다)
AIREVIEW_MODEL=Qwen/Qwen3-VL-8B-Instruct
# 가중치 revision (Hugging Face 커밋 해시). 2026-10-11 라이선스 확인 때의 revision:
#   Qwen/Qwen3-VL-8B-Instruct 0c351dd01ed87e9c1b53cbc748cba10e6187ff3b
# 바꾸면 aireview.yaml backend.fingerprint도 바꾼다 (판정 버전이 바뀐다)
AIREVIEW_REVISION=0c351dd01ed87e9c1b53cbc748cba10e6187ff3b
VLM_AIREVIEW_PORT=8000
AIREVIEW_GPU_MEMORY=0.4
AIREVIEW_MAX_NUM_SEQS=32

# 행동 분류 모델 (--profile actions, config/policies/actions.yaml vlm.model)
ACTIONS_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
ACTIONS_REVISION=cc594898137f460bfe9f0759e9844b3ce807cfb5
VLM_ACTIONS_PORT=8001
ACTIONS_GPU_MEMORY=0.3
ACTIONS_MAX_NUM_SEQS=32

# 비공개 모델이 필요할 때만 (지금 후보는 모두 공개 모델)
HF_TOKEN=
